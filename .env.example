# Copy to .env and fill in. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OCR engine: gemini | tesseract | auto (gemini if key present, else tesseract)
OCR_ENGINE=auto
# Embeddings: auto | gemini | sentence-transformers | tfidf
EMBEDDINGS=auto
# Vector store: numpy | chroma
VECTOR_STORE=numpy
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
